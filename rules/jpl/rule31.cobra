def jpl_rule31
	r
	%{
		if (.fnm != incode.fnm)
		{	incode = none;
		}
		if (.txt == ";" || .round > 0 || .curly > 0)
		{	incode = .;
		}
		if (@cpp && ~"include")
		{	if (incode.lnr > 0)
			{	incode.mark++;
				# print .fnm ":" .lnr "\t" incode.fnm ":" incode.lnr " " .txt "\n";
		}	}
	%}
	ps create R31
	ps caption R31 Include directives should not be preceded by code
end
